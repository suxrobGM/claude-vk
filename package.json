{
  "name": "claude-vk",
  "private": true,
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "start": "bun run --cwd server --silent start",
    "dev": "bun run --cwd server --silent dev",
    "build": "bun run --cwd server --silent build",
    "release": "bun run build && bun scripts/sync-to-marketplace.ts",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome lint .",
    "check": "biome check .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,less,scss,json,jsonc,md}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "^1.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "typescript": "^7.0.2"
  }
}
